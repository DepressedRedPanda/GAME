# Unreal Engine build output (regenerated on every PC)
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Build/
Plugins/*/Binaries/
Plugins/*/Intermediate/

# IDE / project files (regenerate with "Generate Visual Studio project files")
.vs/
.vscode/
.idea/
*.sln
*.suo
*.sdf
*.VC.db
*.opendb
*.xcworkspace

# Python
__pycache__/
*.pyc

# Secrets: API keys live in GitHub Secrets, never in the repo
.env
*.key

# NOTE: .uasset and .umap are NOT ignored. They are tracked with Git LFS (.gitattributes).
